# Keep this repository scoped to the VK -> Discord project.
# Existing downloads, transfer helpers and unrelated project files stay outside Git.
*
!/.gitignore
!/.gitattributes
!/README.md
!/DEVELOPMENT.md
!/CODEX_HANDOFF.md
!/AGENTS.md
!/test_*.py
!/VK_*PROGRESS*.md
!/VK_API_READY_2026-11-24.md
!/vk_discord_plan.md
!/vk_discord_publisher/
!/vk_discord_publisher/**
!/vk_album_downloader/
!/vk_album_downloader/**
!/vk_card_update/
!/vk_card_update/**
!/vk_card_update_v2/
!/vk_card_update_v2/**
# Temporary import location for the current installed source (code only).
!/vk_discord_current/
!/vk_discord_current/*.py
!/vk_discord_current/*.ps1
!/vk_discord_current/*.cmd
!/vk_discord_current/requirements*.lock
!/vk_discord_current/README*.txt
!/vk_discord_current/stage*_base_hashes.json
!/vk_discord_current/SOURCE_IMPORT.json

# Never version credentials or runtime data, including inside allowed folders.
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/state/
**/downloads/
**/logs/
**/diagnostics/
**/updates/
**/config.json
**/config.*.json
**/.env
**/.env.*
**/*.dpapi
**/cookies*
**/*cookies*.txt
**/*cookies*.json
**/token*.json
**/credentials*.json
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.log
**/*.lock
!**/requirements.lock
!**/requirements-ui.lock
**/*.zip
**/*.cbz
**/*.jpg
**/*.jpeg
**/*.png
**/*.gif
**/*.webp
**/*.ico
**/card_update_result.json
