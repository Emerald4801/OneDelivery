# Keep this repository scoped to the VK -> Discord project.
# Existing downloads, transfer helpers and unrelated project files stay outside Git.
*
!/.gitignore
!/.gitattributes
!/README.md
!/DEVELOPMENT.md
!/READINESS.md
!/CODEX_HANDOFF.md
!/AGENTS.md
!/test_*.py
!/VK_*PROGRESS*.md
!/VK_API_READY_2026-11-24.md
!/vk_discord_plan.md
!/vk_discord_publisher/
!/vk_discord_publisher/**
!/vk_album_downloader/
!/vk_album_downloader/**
!/vk_card_update/
!/vk_card_update/**
!/vk_card_update_v2/
!/vk_card_update_v2/**
!/onedelivery_update/
!/onedelivery_update/**
!/UPDATE_ONEDELIVERY.cmd
!/INSTALL_ONEDELIVERY.cmd
!/.github/
!/.github/workflows/
!/.github/workflows/windows.yml
!/ci/
!/ci/**
**/payload/
/onedelivery_update/package.json
# Never version credentials or runtime data, including inside allowed folders.
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/node_modules/
**/state/
**/downloads/
**/logs/
**/diagnostics/
**/updates/
**/config.json
**/config.*.json
**/.env
**/.env.*
**/*.dpapi
**/cookies*
**/*cookies*.txt
**/*cookies*.json
**/token*.json
**/credentials*.json
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.log
**/*.lock
!**/requirements.lock
!**/requirements-ui.lock
**/*.zip
**/*.cbz
**/*.jpg
**/*.jpeg
**/*.png
**/*.gif
**/*.webp
**/*.ico
**/card_update_result.json
